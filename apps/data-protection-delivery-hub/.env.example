# Safe default. The current build supports Demo mode only.
VITE_HUB_MODE=demo

# Set these only in an approved build pipeline. They are configuration values,
# not secrets. The live adapter must be implemented and approved before use.
VITE_LIVE_ADAPTER_CONFIGURED=false
VITE_DATAVERSE_URL=
VITE_PUBLISHER_PREFIX=dpdh
VITE_SHAREPOINT_SITE_URL=
VITE_SHAREPOINT_EVIDENCE_LIBRARY=
